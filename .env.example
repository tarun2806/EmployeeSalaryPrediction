# Copy to .env for local development. Never commit .env.

# Initial admin account seeded on first run (only used when users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Session lifetime in hours (default 12)
AURORA_SESSION_HOURS=12

# Override SQLite path (default: ./history.db, or /tmp/history.db on Vercel)
# AURORA_DB_PATH=/path/to/app.db

# Comma-separated CORS origins (default: localhost:5000,127.0.0.1:5000)
# AURORA_ALLOWED_ORIGINS=http://localhost:5000
