# Copy to .env for local development. Never commit .env.

# Override SQLite path (default: ./history.db, or /tmp/history.db on Vercel)
# ESPS_DB_PATH=/path/to/app.db

# Comma-separated CORS origins (default: localhost:5000,127.0.0.1:5000)
# ESPS_ALLOWED_ORIGINS=http://localhost:5000

# Set to 1 only when deployed behind a trusted reverse proxy (e.g. Vercel)
# so X-Forwarded-For is honored for rate limiting
# ESPS_TRUST_PROXY=1
